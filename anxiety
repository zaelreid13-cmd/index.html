<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HappyGo Watch - Anxiety Edition</title>
<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background: #0a0a0a;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    font-family: 'Segoe UI', -apple-system, sans-serif;
    padding: 20px;
}

/* ===== MAIN CONTAINER ===== */
.container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 30px;
}

/* ===== WATCH ===== */
.watch {
    background: #1A1A1A;
    border-radius: 50%;
    width: 320px;
    height: 320px;
    padding: 20px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.9), 0 0 0 3px #333, 0 0 0 6px #1A1A1A;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transition: box-shadow 0.3s;
}

.watch-screen {
    background: #1A1A1A;
    border-radius: 50%;
    width: 100%;
    height: 100%;
    padding: 25px 20px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    position: relative;
}

/* ===== WATCH HEADER ===== */
.watch-header {
    display: flex;
    justify-content: space-between;
    width: 100%;
    font-size: 11px;
    color: #888;
    padding: 0 4px;
}

.watch-header .time {
    color: #aaa;
    font-weight: 600;
}

.watch-header .status {
    display: flex;
    align-items: center;
    gap: 6px;
}

.watch-header .status .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #4CAF50;
}

/* ===== PROGRESS DOTS ===== */
.progress-dots {
    display: flex;
    gap: 6px;
    margin: 4px 0 6px;
}

.progress-dots span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #444;
    transition: background 0.3s;
}

.progress-dots span.active {
    background: #4A90D9;
}

.progress-dots span.completed {
    background: #4A90D9;
    opacity: 0.4;
}

/* ===== STEP DISPLAY ===== */
.step-display {
    text-align: center;
    margin: 6px 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.step-display .step-icon {
    font-size: 32px;
    margin-bottom: 4px;
}

.step-display .step-text {
    font-size: 26px;
    font-weight: 700;
    color: #FFFFFF;
    line-height: 1.2;
    min-height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.step-display .step-sub {
    font-size: 14px;
    color: #999;
    margin-top: 2px;
    min-height: 24px;
}

/* ===== ANXIETY INDICATOR ===== */
.anxiety-indicator {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    color: #888;
    margin: 4px 0 6px;
    padding: 4px 12px;
    background: #222;
    border-radius: 20px;
}

.anxiety-indicator .anxiety-bar {
    display: flex;
    gap: 3px;
}

.anxiety-indicator .anxiety-bar span {
    width: 10px;
    height: 5px;
    border-radius: 2px;
    background: #444;
    transition: background 0.3s;
}

.anxiety-indicator .anxiety-bar span.fill {
    background: #4A90D9;
}

.anxiety-indicator .anxiety-bar span.fill.moderate {
    background: #FFB74D;
}

.anxiety-indicator .anxiety-bar span.fill.high {
    background: #E53935;
}

.anxiety-indicator .anxiety-label {
    min-width: 32px;
    text-align: right;
}

/* ===== SUPPORT BUTTON ===== */
.btn-support {
    background: #4A90D9;
    color: #FFFFFF;
    border: none;
    border-radius: 30px;
    padding: 10px 28px;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s, transform 0.1s;
    margin: 4px 0 2px;
    width: 100%;
    max-width: 180px;
}

.btn-support:hover {
    background: #357ABD;
}

.btn-support:active {
    transform: scale(0.95);
}

.btn-support.requested {
    background: #555;
    cursor: default;
}

/* ===== BREATHE BUTTON ===== */
.btn-breathe {
    background: transparent;
    color: #4A90D9;
    border: 2px solid #4A90D9;
    border-radius: 30px;
    padding: 6px 18px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    margin-top: 2px;
}

.btn-breathe:hover {
    background: #4A90D9;
    color: #fff;
}

.btn-breathe:active {
    transform: scale(0.95);
}

.btn-breathe.active {
    background: #4A90D9;
    color: #fff;
    animation: breathePulse 2s ease-in-out infinite;
}

@keyframes breathePulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
}

/* ===== CONTROLS ===== */
.controls {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 10px;
}

.controls button {
    background: #333;
    color: #fff;
    border: none;
    border-radius: 12px;
    padding: 10px 18px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
    min-width: 60px;
}

.controls button:hover {
    background: #444;
}

.controls button:active {
    transform: scale(0.96);
}

.controls button.active-btn {
    background: #4A90D9;
}

.controls button.active-btn:hover {
    background: #357ABD;
}

/* ===== STATUS MESSAGE ===== */
.status-msg {
    color: #aaa;
    font-size: 13px;
    text-align: center;
    min-height: 30px;
    margin-top: 6px;
    padding: 6px 14px;
    background: #1a1a1a;
    border-radius: 8px;
    border: 1px solid #333;
    max-width: 320px;
    transition: all 0.3s;
}

.status-msg .highlight {
    color: #4A90D9;
    font-weight: 600;
}

.status-msg .success {
    color: #4CAF50;
}

.status-msg .calm {
    color: #4A90D9;
}

/* ===== FEATURE LABELS ===== */
.feature-labels {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
    font-size: 11px;
    color: #666;
    margin-top: 4px;
}

.feature-labels span {
    background: #1a1a1a;
    padding: 4px 12px;
    border-radius: 12px;
    border: 1px solid #2a2a2a;
}

/* ===== BREATHING OVERLAY ===== */
.breathe-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.85);
    z-index: 1000;
    justify-content: center;
    align-items: center;
    flex-direction: column;
}

.breathe-overlay.active {
    display: flex;
}

.breathe-overlay .breathe-circle {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    border: 4px solid #4A90D9;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    animation: breatheCircle 4s ease-in-out infinite;
    background: rgba(74, 144, 217, 0.1);
}

@keyframes breatheCircle {
    0%, 100% { transform: scale(1); border-color: #4A90D9; }
    50% { transform: scale(1.3); border-color: #4A90D9; }
}

.breathe-overlay .breathe-text {
    font-size: 32px;
    font-weight: 700;
    color: #FFFFFF;
    margin-top: 30px;
    animation: breatheText 4s ease-in-out infinite;
}

@keyframes breatheText {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
}

.breathe-overlay .breathe-close {
    margin-top: 40px;
    background: #333;
    color: #fff;
    border: none;
    border-radius: 12px;
    padding: 12px 30px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
}

.breathe-overlay .breathe-close:hover {
    background: #444;
}

.breathe-overlay .breathe-count {
    font-size: 48px;
    font-weight: 700;
    color: #4A90D9;
    margin-top: 10px;
}

/* ===== RESPONSIVE ===== */
@media (max-width: 380px) {
    .watch {
        width: 260px;
        height: 260px;
        padding: 14px;
    }
    .watch-screen {
        padding: 18px 14px 14px;
    }
    .step-display .step-text {
        font-size: 20px;
        min-height: 44px;
    }
    .step-display .step-icon {
        font-size: 24px;
    }
    .step-display .step-sub {
        font-size: 12px;
    }
    .btn-support {
        font-size: 13px;
        padding: 8px 20px;
        max-width: 140px;
    }
    .controls button {
        font-size: 11px;
        padding: 8px 12px;
        min-width: 50px;
    }
    .watch-header {
        font-size: 10px;
    }
    .anxiety-indicator {
        font-size: 10px;
        padding: 3px 10px;
    }
    .anxiety-indicator .anxiety-bar span {
        width: 8px;
        height: 4px;
    }
    .breathe-overlay .breathe-circle {
        width: 150px;
        height: 150px;
    }
    .breathe-overlay .breathe-text {
        font-size: 24px;
    }
    .breathe-overlay .breathe-count {
        font-size: 36px;
    }
}

@media (max-width: 300px) {
    .watch {
        width: 210px;
        height: 210px;
        padding: 10px;
    }
    .watch-screen {
        padding: 12px 10px 10px;
    }
    .step-display .step-text {
        font-size: 16px;
        min-height: 34px;
    }
    .step-display .step-icon {
        font-size: 18px;
    }
    .step-display .step-sub {
        font-size: 10px;
    }
    .btn-support {
        font-size: 11px;
        padding: 6px 14px;
        max-width: 110px;
    }
    .controls button {
        font-size: 10px;
        padding: 6px 8px;
        min-width: 40px;
    }
    .progress-dots span {
        width: 6px;
        height: 6px;
    }
    .anxiety-indicator {
        font-size: 9px;
        padding: 2px 8px;
    }
    .anxiety-indicator .anxiety-bar span {
        width: 6px;
        height: 3px;
    }
}
</style>
</head>
<body>

<div class="container">

    <!-- ===== WATCH ===== -->
    <div class="watch" id="watch">
        <div class="watch-screen">

            <!-- Header -->
            <div class="watch-header">
                <span class="time" id="watchTime">1:45 PM</span>
                <span class="status">
                    <span class="dot"></span>
                    <span id="connectionStatus">Connected</span>
                </span>
            </div>

            <!-- Progress Dots -->
            <div class="progress-dots" id="progressDots">
                <span class="completed"></span>
                <span class="completed"></span>
                <span class="completed"></span>
                <span class="active"></span>
                <span></span>
                <span></span>
            </div>

            <!-- Step Display -->
            <div class="step-display">
                <div class="step-icon" id="stepIcon">🚪</div>
                <div class="step-text" id="stepText">Gate 7</div>
                <div class="step-sub" id="stepSub">4 min walk</div>
            </div>

            <!-- Anxiety Indicator -->
            <div class="anxiety-indicator">
                <span>💙 Anxiety:</span>
                <div class="anxiety-bar" id="anxietyBar">
                    <span class="fill"></span>
                    <span class="fill"></span>
                    <span class="fill"></span>
                    <span></span>
                    <span></span>
                </div>
                <span class="anxiety-label" id="anxietyLabel">Low</span>
            </div>

            <!-- Support Button -->
            <button class="btn-support" id="supportBtn">💙 NEED SUPPORT?</button>

            <!-- Breathe Button -->
            <button class="btn-breathe" id="breatheBtn">🌿 Breathe</button>

        </div>
    </div>

    <!-- ===== CONTROLS ===== -->
    <div class="controls">
        <button data-step="0">🏠 Start</button>
        <button data-step="1">✈️ Check-in</button>
        <button data-step="2">🛂 Security</button>
        <button data-step="3">🚪 Gate</button>
        <button data-step="4">🎫 Boarding</button>
        <button data-step="5">🏝️ Arrive</button>
    </div>

    <div class="controls">
        <button id="anxietyLow">💙 Low</button>
        <button id="anxietyModerate">💛 Moderate</button>
        <button id="anxietyHigh">❤️ High</button>
        <button id="calmBtn">🧘 Calm (Double-Tap)</button>
        <button id="resetBtn">↺ Reset</button>
    </div>

    <!-- ===== STATUS MESSAGE ===== -->
    <div class="status-msg" id="statusMsg">
        👋 Welcome to HappyGo • Anxiety support at your wrist
    </div>

    <!-- ===== FEATURE LABELS ===== -->
    <div class="feature-labels">
        <span>🧘 Breathe Tool</span>
        <span>💙 Silent Support</span>
        <span>📊 Anxiety Monitor</span>
        <span>⏱️ Calm Countdowns</span>
        <span>🔇 Quiet Mode</span>
    </div>

</div>

<!-- ===== BREATHING OVERLAY ===== -->
<div class="breathe-overlay" id="breatheOverlay">
    <div class="breathe-circle">
        <div class="breathe-count" id="breatheCount">4</div>
    </div>
    <div class="breathe-text" id="breatheText">Breathe In</div>
    <button class="breathe-close" id="breatheClose">Close</button>
</div>

<script>
// ============================================================
// DATA
// ============================================================
const steps = [
    { icon: '🏠', text: 'Head to Airport', sub: 'Check-in in 30 min' },
    { icon: '✈️', text: 'Check-in Desk 4', sub: 'Caribbean Airlines' },
    { icon: '🛂', text: 'Security', sub: 'Quiet route available' },
    { icon: '🚪', text: 'Gate 7', sub: '4 min walk' },
    { icon: '🎫', text: 'Boarding Now', sub: 'Gate 7 • Take your time' },
    { icon: '🏝️', text: 'Arrived!', sub: 'Welcome to Barbados' }
];

let currentStep = 3;
let isSupportRequested = false;
let isCalmActive = false;
let calmTimer = null;
let anxietyLevel = 0; // 0 = Low, 1 = Moderate, 2 = High
let breatheInterval = null;
let breatheCount = 4;
let breathePhase = 0; // 0 = In, 1 = Hold, 2 = Out

// ============================================================
// DOM REFS
// ============================================================
const stepIcon = document.getElementById('stepIcon');
const stepText = document.getElementById('stepText');
const stepSub = document.getElementById('stepSub');
const progressDots = document.getElementById('progressDots');
const supportBtn = document.getElementById('supportBtn');
const statusMsg = document.getElementById('statusMsg');
const anxietyBar = document.getElementById('anxietyBar');
const anxietyLabel = document.getElementById('anxietyLabel');
const watchTime = document.getElementById('watchTime');
const watch = document.getElementById('watch');
const breatheOverlay = document.getElementById('breatheOverlay');
const breatheText = document.getElementById('breatheText');
const breatheCount = document.getElementById('breatheCount');
const breatheClose = document.getElementById('breatheClose');
const breatheBtn = document.getElementById('breatheBtn');

// ============================================================
// UPDATE FUNCTIONS
// ============================================================
function updateWatch(index) {
    currentStep = Math.max(0, Math.min(index, steps.length - 1));
    const step = steps[currentStep];

    stepIcon.textContent = step.icon;
    stepText.textContent = step.text;
    stepSub.textContent = step.sub;

    const dots = progressDots.querySelectorAll('span');
    dots.forEach((dot, i) => {
        dot.className = '';
        if (i < currentStep) dot.classList.add('completed');
        else if (i === currentStep) dot.classList.add('active');
    });

    if (isSupportRequested) {
        isSupportRequested = false;
        supportBtn.textContent = '💙 NEED SUPPORT?';
        supportBtn.classList.remove('requested');
        setStatus('📍 ' + step.text + ' • ' + step.sub, '#aaa');
    }

    setStatus('📍 ' + step.text + ' • ' + step.sub, '#aaa');
    updateTime();
}

function updateTime() {
    const now = new Date();
    let h = now.getHours();
    let m = now.getMinutes();
    const ampm = h >= 12 ? 'PM' : 'AM';
    h = h % 12 || 12;
    watchTime.textContent = h + ':' + String(m).padStart(2, '0') + ' ' + ampm;
}

function setStatus(msg, color = '#aaa') {
    statusMsg.innerHTML = msg;
    statusMsg.style.color = color;
}

function setAnxietyLevel(level) {
    const bars = anxietyBar.querySelectorAll('span');
    const labels = ['Low', 'Moderate', 'High'];
    const colors = ['#4A90D9', '#FFB74D', '#E53935'];
    const safeIdx = Math.max(0, Math.min(level, 2));

    bars.forEach((bar, i) => {
        bar.className = '';
        if (i <= safeIdx) {
            bar.classList.add('fill');
            if (safeIdx === 0) bar.style.background = '#4A90D9';
            else if (safeIdx === 1) bar.style.background = '#FFB74D';
            else bar.style.background = '#E53935';
        } else {
            bar.style.background = '#444';
        }
    });

    anxietyLabel.textContent = labels[safeIdx];
    anxietyLevel = safeIdx;

    // Update watch glow based on anxiety level
    if (safeIdx === 0) {
        watch.style.boxShadow = '0 20px 60px rgba(0,0,0,0.9), 0 0 0 3px #333, 0 0 0 6px #1A1A1A';
    } else if (safeIdx === 1) {
        watch.style.boxShadow = '0 20px 60px rgba(0,0,0,0.9), 0 0 0 3px #FFB74D, 0 0 0 6px #1A1A1A';
    } else {
        watch.style.boxShadow = '0 20px 60px rgba(0,0,0,0.9), 0 0 0 3px #E53935, 0 0 0 6px #1A1A1A';
    }

    const msgs = ['💙 Anxiety: Low • You\'re doing well', '💛 Anxiety: Moderate • Take a moment to breathe', '❤️ Anxiety: High • Support is available'];
    setStatus(msgs[safeIdx], colors[safeIdx]);
}

// ============================================================
// SUPPORT REQUEST
// ============================================================
function requestSupport() {
    if (isSupportRequested) {
        setStatus('✅ Support already on the way', '#4CAF50');
        return;
    }

    isSupportRequested = true;
    supportBtn.textContent = '⏳ SENT';
    supportBtn.classList.add('requested');

    const step = steps[currentStep];
    setStatus(
        '🟢 <span class="success">Silent support request sent!</span> Staff notified at ' + step.text,
        '#4CAF50'
    );

    setTimeout(() => {
        if (isSupportRequested) {
            isSupportRequested = false;
            supportBtn.textContent = '💙 NEED SUPPORT?';
            supportBtn.classList.remove('requested');
            setStatus('📍 ' + step.text + ' • ' + step.sub, '#aaa');
        }
    }, 5000);
}

// ============================================================
// CALMING TOOL
// ============================================================
function activateCalm() {
    if (isCalmActive) {
        setStatus('🧘 Calming already active...', '#4A90D9');
        return;
    }

    isCalmActive = true;
    setStatus('🧘 <span class="calm">Calming vibration</span> activated • 60 seconds', '#4A90D9');

    watch.style.boxShadow = '0 0 40px rgba(74,144,217,0.3), 0 0 80px rgba(74,144,217,0.1), 0 0 0 3px #333, 0 0 0 6px #1A1A1A';

    let pulseCount = 0;
    calmTimer = setInterval(() => {
        pulseCount++;
        if (pulseCount % 2 === 0) {
            watch.style.boxShadow = '0 0 50px rgba(74,144,217,0.4), 0 0 100px rgba(74,144,217,0.15), 0 0 0 3px #333, 0 0 0 6px #1A1A1A';
        } else {
            watch.style.boxShadow = '0 0 20px rgba(74,144,217,0.2), 0 0 40px rgba(74,144,217,0.05), 0 0 0 3px #333, 0 0 0 6px #1A1A1A';
        }
    }, 400);

    setTimeout(() => {
        if (isCalmActive) {
            isCalmActive = false;
            clearInterval(calmTimer);
            calmTimer = null;
            const step = steps[currentStep];
            setStatus('🧘 Calming complete • ' + step.text, '#aaa');
            setAnxietyLevel(anxietyLevel);
        }
    }, 60000);
}

// ============================================================
// BREATHING EXERCISE
// ============================================================
function startBreathing() {
    breatheOverlay.classList.add('active');
    breathePhase = 0;
    breatheCount = 4;
    startBreatheCycle();
}

function startBreatheCycle() {
    if (breatheInterval) clearInterval(breatheInterval);

    breatheCount = 4;
    breathePhase = 0;
    breatheText.textContent = 'Breathe In';
    breatheText.style.color = '#4A90D9';
    breatheCount.textContent = '4';

    let phaseTime = 0;
    breatheInterval = setInterval(() => {
        phaseTime++;

        if (breathePhase === 0) {
            // Breathing in - count down from 4 to 1
            breatheCount.textContent = Math.max(1, 4 - phaseTime);
            breatheText.textContent = 'Breathe In';
            breatheText.style.color = '#4A90D9';
            if (phaseTime >= 4) {
                breathePhase = 1;
                phaseTime = 0;
                breatheCount.textContent = '4';
                breatheText.textContent = 'Hold';
                breatheText.style.color = '#FFB74D';
            }
        } else if (breathePhase === 1) {
            // Hold - count down from 4 to 1
            breatheCount.textContent = Math.max(1, 4 - phaseTime);
            breatheText.textContent = 'Hold';
            breatheText.style.color = '#FFB74D';
            if (phaseTime >= 4) {
                breathePhase = 2;
                phaseTime = 0;
                breatheCount.textContent = '4';
                breatheText.textContent = 'Breathe Out';
                breatheText.style.color = '#E53935';
            }
        } else if (breathePhase === 2) {
            // Breathe out - count down from 4 to 1
            breatheCount.textContent = Math.max(1, 4 - phaseTime);
            breatheText.textContent = 'Breathe Out';
            breatheText.style.color = '#E53935';
            if (phaseTime >= 4) {
                breathePhase = 0;
                phaseTime = 0;
                breatheCount.textContent = '4';
                breatheText.textContent = 'Breathe In';
                breatheText.style.color = '#4A90D9';
                // Reduce anxiety level after a full cycle
                if (anxietyLevel > 0) {
                    setAnxietyLevel(anxietyLevel - 1);
                }
            }
        }
    }, 800);
}

function stopBreathing() {
    breatheOverlay.classList.remove('active');
    if (breatheInterval) {
        clearInterval(breatheInterval);
        breatheInterval = null;
    }
    setStatus('🧘 Breathing exercise complete • Feel calmer?', '#4CAF50');
}

// ============================================================
// RESET
// ============================================================
function resetAll() {
    if (isCalmActive) {
        isCalmActive = false;
        clearInterval(calmTimer);
        calmTimer = null;
    }

    isSupportRequested = false;
    supportBtn.textContent = '💙 NEED SUPPORT?';
    supportBtn.classList.remove('requested');

    updateWatch(3);
    setAnxietyLevel(0);

    setStatus('↺ Reset complete • Back to Gate 7', '#aaa');
}

// ============================================================
// EVENT LISTENERS
// ============================================================

// Step buttons
document.querySelectorAll('[data-step]').forEach(btn => {
    btn.addEventListener('click', () => {
        const idx = parseInt(btn.dataset.step);
        updateWatch(idx);
        setAnxietyLevel(0);
    });
});

// Support button
supportBtn.addEventListener('click', requestSupport);

// Double-tap on watch for calming
const watchEl = document.querySelector('.watch');
watchEl.addEventListener('dblclick', activateCalm);

// Anxiety buttons
document.getElementById('anxietyLow').addEventListener('click', () => setAnxietyLevel(0));
document.getElementById('anxietyModerate').addEventListener('click', () => setAnxietyLevel(1));
document.getElementById('anxietyHigh').addEventListener('click', () => setAnxietyLevel(2));

// Calm button (manual)
document.getElementById('calmBtn').addEventListener('click', activateCalm);

// Reset button
document.getElementById('resetBtn').addEventListener('click', resetAll);

// Breathe button
breatheBtn.addEventListener('click', startBreathing);

// Breathe close button
breatheClose.addEventListener('click', stopBreathing);

// Close breathing on click outside circle
breatheOverlay.addEventListener('click', (e) => {
    if (e.target === breatheOverlay) {
        stopBreathing();
    }
});

// ============================================================
// KEYBOARD SHORTCUTS
// ============================================================
document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        e.preventDefault();
        updateWatch(currentStep + 1);
        setAnxietyLevel(0);
    } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        e.preventDefault();
        updateWatch(currentStep - 1);
        setAnxietyLevel(0);
    } else if (e.key === ' ' || e.key === 'Enter') {
        e.preventDefault();
        requestSupport();
    } else if (e.key === 'c' || e.key === 'C') {
        activateCalm();
    } else if (e.key === 'b' || e.key === 'B') {
        startBreathing();
    } else if (e.key === 'r' || e.key === 'R') {
        resetAll();
    } else if (e.key === 'Escape') {
        if (breatheOverlay.classList.contains('active')) {
            stopBreathing();
        }
    }
});

// ============================================================
// INIT
// ============================================================
updateWatch(3);
setAnxietyLevel(0);
updateTime();
setStatus('👋 Welcome to HappyGo • Anxiety support at your wrist', '#aaa');

setInterval(updateTime, 10000);

console.log('🧘 HappyGo Watch - Anxiety Edition');
console.log('📌 Controls:');
console.log('  → Arrow keys: Navigate steps');
console.log('  → Space/Enter: Request support');
console.log('  → C: Activate calming tool');
console.log('  → B: Start breathing exercise');
console.log('  → R: Reset');
console.log('  → Double-tap watch: Calming tool');
console.log('  → Esc: Close breathing exercise');
